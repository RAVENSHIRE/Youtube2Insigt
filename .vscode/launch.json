{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "SignalTube server (3100)",
      "program": "${workspaceFolder}/server/server.js",
      "cwd": "${workspaceFolder}",
      "env": {
        "PORT": "3100",
        "PUBLIC_BASE_URL": "http://localhost:3100"
      },
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}