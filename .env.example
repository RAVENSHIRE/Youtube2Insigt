# Copy to .env at the project root. Never commit real values.
APP_MODE=accounts
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Required in production: absolute path on a backed-up persistent volume.
ACCOUNT_DB_PATH=
# chrome-extension://YOUR_ACTUAL_EXTENSION_ID (comma separated if necessary)
EXTENSION_ORIGINS=
TRUST_PROXY_HOPS=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
YOUTUBE_API_KEY=
# Resend sending key (not Gemini/YouTube). Verify the sending domain in Resend first.
RESEND_API_KEY=
# Example format: YT Research <verify@your-verified-domain.example>
# resend.dev test senders are restricted; production needs your own verified domain.
MAIL_FROM=
# One monthly recurring Stripe Price; use only test-mode keys during acceptance.
# This feature supports disabled/test only. Live keys cannot initiate checkout.
BILLING_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PRO_MONTHLY_ANALYSES=20
# Optional read-only subscription sync; manual creator selection works without it.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
APP_ENCRYPTION_KEY=
YOUTUBE_OAUTH_APPROVAL_CONFIRMED=false
# Optional authorized audio gateway; not included or deployed by this repository.
AUDIO_TRANSCRIPTION_URL=
AUDIO_TRANSCRIPTION_KEY=
ENABLE_VISUAL_EXTRACTION=false
# Development only until commercial display/storage/redistribution rights confirmed.
COMMERCIAL_MARKET_DATA_APPROVED=false
TWELVE_DATA_API_KEY=
TWELVE_DATA_SAFE_CREDITS_PER_MINUTE=7
MARKET_SNAPSHOT_ROOT=
# Existing legacy data: do not move/delete. Used only in local APP_MODE=legacy.
CREATOR_DATA_ROOT=
# Optional operator-reviewed/licensed corpus, never customer-private exports.
PREMIUM_CORPUS_PATH=
